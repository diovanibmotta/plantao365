{
  "name": "@diovanibmotta/plantao365-web-sdk",
  "version": "1.30.0",
  "description": "SDK do front para plugins do Plantão365: componentes, API e contrato de telas, menus e slots",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diovanibmotta/plantao365.git",
    "directory": "packages/web-sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./ui.css": "./src/ui/ui.css"
  },
  "files": [
    "dist",
    "src/**/*.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
