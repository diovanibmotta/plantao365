{
  "name": "plantao365",
  "private": true,
  "version": "1.12.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm-run-all2 --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @diovanibmotta/plantao365-api",
    "dev:web": "npm run dev -w @diovanibmotta/plantao365-web",
    "build": "npm run build -w @diovanibmotta/plantao365-shared && npm run build -w @diovanibmotta/plantao365-api && npm run build -w @diovanibmotta/plantao365-web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.10.1",
    "semantic-release": "^25.0.9",
    "semantic-release-gitmoji": "^1.6.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
