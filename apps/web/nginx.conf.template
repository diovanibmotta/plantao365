server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  location /api/ {
    # Instalação de plugin envia até 15 MB; acima disso a própria API responde 413.
    client_max_body_size 16m;
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  # Front dos plugins (Module Federation), servido pela API na mesma origem.
  location /plugins-assets/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $http_host;
  }

  location /auth/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  # O mime.types do nginx não conhece .webmanifest; sem isso sai application/octet-stream.
  location = /site.webmanifest {
    default_type application/manifest+json;
    try_files $uri =404;
  }

  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }

  location / {
    try_files $uri /index.html;
  }
}
