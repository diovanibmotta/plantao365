{
  "name": "@diovanibmotta/plantao365-api",
  "version": "1.13.0",
  "description": "API do Plantão365 (Hono + PostgreSQL), distribuída como pacote Node",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diovanibmotta/plantao365.git",
    "directory": "apps/api"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "migrations"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@diovanibmotta/plantao365-shared": "*",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "openid-client": "^6.9.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.7"
  }
}
