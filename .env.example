# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173

# PostgreSQL (ajuste usuário, senha e banco)
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/plantao360

# Gestores iniciais (e-mails separados por vírgula)
MANAGER_EMAILS=

# Master key (primeiro acesso self-hosted): usuário/senha de bootstrap, defina os dois ou nenhum.
# Senha com 12+ caracteres, aleatória (ex.: sk-$(openssl rand -hex 24)); o prefixo sk- é só convenção.
# Não reutilize senhas e evite trocá-la sem necessidade. Remover as duas variáveis desativa o login master.
MASTER_USERNAME=
MASTER_PASSWORD=

# SSO Entra ID: obrigatório em produção; em desenvolvimento, sem SSO use a master key acima.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# SMTP (opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Somente docker compose
POSTGRES_USER=plantao360
POSTGRES_PASSWORD=
POSTGRES_DB=plantao360
WEB_PORT=8080
SMTP_SECURE=false
SESSION_TTL_SECONDS=28800

# Aplica migrações pendentes na subida da API (com lock entre réplicas). false desliga.
AUTO_MIGRATE=true

# Atributo Secure do cookie de sessão. Vazio: ativo apenas em NODE_ENV=production.
# Use true em staging atrás de HTTPS e false para HTTP local em produção.
COOKIE_SECURE=

# Imagem única (Dockerfile da raiz): pasta do build do front servida pela própria API.
# Já definida na imagem; deixe vazio em desenvolvimento (o Vite serve o front).
WEB_DIST_DIR=

# Front em outro domínio que a API (mesmo site, ex.: plantao.exemplo.com e api.exemplo.com):
# origens do front separadas por vírgula. Vazio: front e API no mesmo domínio.
# O front precisa ser buildado com VITE_API_BASE_URL=https://api.exemplo.com
CORS_ALLOWED_ORIGINS=
