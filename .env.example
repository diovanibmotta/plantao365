# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173

# PostgreSQL (ajuste usuário, senha e banco)
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/plantao360

# Gestores iniciais (e-mails separados por vírgula)
MANAGER_EMAILS=gestor@example.com

# SSO Entra ID. Em desenvolvimento use OIDC_MOCK=true; em produção preencha os quatro campos.
OIDC_MOCK=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# SMTP (opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
